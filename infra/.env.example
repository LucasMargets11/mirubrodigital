# =============================================================================
# infra/.env.example — MiRubro Docker Compose (interpolación ${})
# =============================================================================
# Copiar con: cp infra/.env.example infra/.env
#
# Este archivo es la fuente de interpolación de variables ${VAR} y ${VAR:-default}
# en infra/docker-compose.yml e infra/docker-compose.override.yml.
#
# Docker Compose lo carga automáticamente porque vive en el mismo directorio
# que los compose files (infra/).
#
# ATENCIÓN:
# - Este archivo NO es leído por Django ni por Next.js directamente.
# - Django lee services/api/.env (via env_file: en compose + load_dotenv en settings.py)
# - Next.js lee apps/web/.env (via env_file: en compose)
# - Este archivo solo sirve para que Docker Compose resuelva ${VAR} en el YAML.
#
# NUNCA commites el archivo .env real.
# =============================================================================

# ── Frontend URLs (interpolan build.args y environment del servicio web) ─────
# NEXT_PUBLIC_* se embeben en el bundle JS de Next.js en build time.
# Cambiarlos requiere rebuild: docker compose build web

# Local: http://localhost:3000 | Con ngrok: https://TU-URL.ngrok-free.app | Prod: https://www.mirubro.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local: http://localhost:8000 | Prod: https://www.mirubro.com (o subdominio API)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google OAuth (build arg para el servicio web) ────────────────────────────
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_AUTH_BETA_GOOGLE_ONLY=false

# ── Google Maps / Places (build arg para el servicio web) ────────────────────
# API Key con Places API habilitada. Requerida para buscador de negocio en QR Reseñas.
# Obtener en: https://console.cloud.google.com/apis/credentials
# IMPORTANTE: cambiarla requiere rebuild → docker compose build web
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Backend misc ──────────────────────────────────────────────────────────────
# Interpolado en el compose para el servicio api/celery (aunque estos leen su propio .env)
DJANGO_DEBUG=True
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── BASE_PUBLIC_URL (para webhooks de MercadoPago) ───────────────────────────
# LOCAL NORMAL: dejar vacío
# CON NGROK:
#   1. Levantar túnel: docker compose --profile tunnel up ngrok
#   2. Copiar la URL: docker compose logs ngrok | grep "url="
#   3. Pegar aquí y en services/api/.env, reiniciar: docker compose up api
#   4. Al terminar la sesión: VOLVER A VACIAR ESTE CAMPO y el de services/api/.env
BASE_PUBLIC_URL=

# ── Ngrok (solo si se usa el perfil tunnel) ───────────────────────────────────
# Obtener token en: https://dashboard.ngrok.com/authtokens
# Producción: nunca usar ngrok.
NGROK_AUTHTOKEN=
