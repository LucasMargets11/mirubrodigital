# =============================================================================
# services/api/.env.example — MiRubro Backend (Django)
# =============================================================================
# Copiar con: cp services/api/.env.example services/api/.env
# Este template tiene defaults para DESARROLLO LOCAL.
# Para producción, ver la sección "Valores en producción" de cada bloque.
# NUNCA commites el archivo .env real.
# =============================================================================

# ── Django core ──────────────────────────────────────────────────────────────
# Local: True | Producción: False (obligatorio)
DJANGO_DEBUG=True
# REQUIRED — generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Producción: usar AWS Secrets Manager
DJANGO_SECRET_KEY=
# Local: localhost,127.0.0.1,mirubro-api | Producción: api.mirubro.com,mirubro-api
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,mirubro-api

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=mirubro
POSTGRES_USER=mirubro
# REQUIRED. Producción: usar AWS Secrets Manager
POSTGRES_PASSWORD=
# Docker local: postgres | Producción: endpoint RDS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis / Cache / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ── Auth cookies ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
# Local: False | Producción: True
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
# Local: dejar vacío (None) — NUNCA usar "localhost", los browsers lo ignoran
# Producción: .mirubro.com
COOKIE_DOMAIN=

# ── CORS / CSRF ──────────────────────────────────────────────────────────────
# Local: http://localhost:3000 | Producción: https://www.mirubro.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Local: http://localhost:3000 | Producción: https://www.mirubro.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_DEPTH=1

# ── Public URLs ───────────────────────────────────────────────────────────────
# FRONTEND_URL: URL pública del frontend (usada en emails y redirects)
# Local: http://localhost:3000 | Producción: https://www.mirubro.com
FRONTEND_URL=http://localhost:3000

# PUBLIC_MENU_BASE_URL: URL base para las cartas QR públicas
# Local: http://localhost:3000 | Producción: https://www.mirubro.com
PUBLIC_MENU_BASE_URL=http://localhost:3000

# BASE_PUBLIC_URL: URL pública de *este* servidor API (usada para webhooks de MP)
# LOCAL NORMAL: dejar vacío — no se necesita para desarrollo sin webhooks
# CON NGROK: usar la URL del túnel (ej: https://abc123.ngrok-free.app)
#   1. Levantar ngrok: docker compose --profile tunnel up ngrok
#   2. Copiar la URL del log: docker compose logs ngrok
#   3. Poner la URL aquí y reiniciar: docker compose up api
#   4. Al terminar, VOLVER A VACIAR este campo
# Producción: https://api.mirubro.com (o el dominio real del API)
BASE_PUBLIC_URL=

# ── MFA ──────────────────────────────────────────────────────────────────────
# REQUIRED — generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Producción: usar AWS Secrets Manager
MFA_ENCRYPTION_KEY=
# Solo para setup inicial. Deshabilitar en producción una vez enrollado.
MFA_BOOTSTRAP_ENABLED=false

# ── MercadoPago ───────────────────────────────────────────────────────────────
# USAR SIEMPRE CREDENCIALES DE TEST en desarrollo local.
# Obtener en: https://www.mercadopago.com.ar/settings/account/credentials
# Producción: usar AWS Secrets Manager
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_BASE_URL=https://api.mercadopago.com
# Solo necesario para el flujo OAuth por-negocio
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
# REQUIRED — cifra en reposo access_token/refresh_token de MercadoPagoConnection.
# Clave dedicada, distinta de MFA_ENCRYPTION_KEY. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Producción: usar AWS Secrets Manager
MP_TOKEN_ENCRYPTION_KEY=
# Cifra en reposo los secretos HMAC del agente de WhatsApp (apps.leads AgentCredential).
# Clave dedicada, distinta de MP_TOKEN_ENCRYPTION_KEY y MFA_ENCRYPTION_KEY. Sin ella,
# `provision_agent` y la verificación de credenciales fallan cerrado. Generar igual que arriba.
AGENT_SECRET_ENCRYPTION_KEY=
# AGENT 02B: habilita el receiver PUT /api/v1/integrations/agent/leads/<uuid>/ (HMAC).
# Default false → el endpoint responde 503. En true exige AGENT_SECRET_ENCRYPTION_KEY
# válida: si falta, `manage.py check`/`migrate` fallan (leads.E001/E002).
AGENT_INTEGRATION_ENABLED=false
# Throttle por AgentInstance (requests firmadas). Formato DRF.
AGENT_LEADS_SYNC_THROTTLE_RATE=600/minute
# MIRUBRO TAKEOVER 05A: comandos MiRubro → Agent (pausar/reanudar el bot). Credencial
# PROPIA de esta dirección (= MIRUBRO_INBOUND_KEY_ID / MIRUBRO_INBOUND_SECRET del bot);
# nunca reutilizar la del receiver. Default false → POST takeover/release responde 503.
# En true: base URL https (http solo con DEBUG), key id ^[A-Za-z0-9_.-]{1,64}$, secret
# 32–512 bytes; si no, `manage.py check` falla (leads.E003–E006). Ver docs/MIRUBRO_TAKEOVER_CLIENT.md.
AGENT_TAKEOVER_ENABLED=false
AGENT_TAKEOVER_BASE_URL=
AGENT_TAKEOVER_KEY_ID=
AGENT_TAKEOVER_SECRET=
AGENT_TAKEOVER_MAX_ATTEMPTS=10

# ── Email transaccional ───────────────────────────────────────────────────────
# EMAIL_BACKEND: backend de envío
# Local/dev: console (imprime en stdout, sin enviar)
# Con SMTP: django.core.mail.backends.smtp.EmailBackend
# Con SES (producción recomendado): apps.notifications usa el provider SES directamente,
#   no via EMAIL_BACKEND — ver EMAIL_PROVIDER abajo
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
# SendGrid API key (si EMAIL_BACKEND=smtp). Producción: AWS Secrets Manager
EMAIL_HOST_PASSWORD=

# ── Notifications (apps.notifications) ───────────────────────────────────────
# EMAIL_PROVIDER: proveedor usado por apps.notifications
# Valores: "django" (usa EMAIL_BACKEND/SMTP) | "amazon_ses" (SES v2 directo)
# Local: "django" (con backend console para no enviar mails reales)
# Producción: "amazon_ses" (requiere IAM Role con permiso ses:SendEmail)
EMAIL_PROVIDER=django

# DEFAULT_FROM_EMAIL: dirección "De:" por defecto para todos los emails
DEFAULT_FROM_EMAIL=MiRubro <notificaciones@mirubro.com>
SERVER_EMAIL=MiRubro <notificaciones@mirubro.com>
SUPPORT_EMAIL=mirubrodigital@gmail.com
BILLING_EMAIL=mirubrodigital@gmail.com

# AWS SES (solo si EMAIL_PROVIDER=amazon_ses)
# Credenciales: NO poner access keys. Usar IAM Role (EC2/ECS).
AWS_SES_REGION=sa-east-1
# Configuration Set de SES (opcional, para tracking de bounces/complaints)
AWS_SES_CONFIGURATION_SET=

# ── Comunicaciones al Customer (apps.customers, CUSTOMER 07D.3A) ─────────────
# Proveedor de email para CustomerMessageDelivery: "fake" (default, no envía) | "ses".
# Local/tests/CI: dejar "fake". "ses" usa AWS_SES_REGION/AWS_SES_CONFIGURATION_SET
# de arriba y la cadena normal de credenciales boto3 (IAM Role; nunca keys en el repo).
CUSTOMER_DELIVERY_PROVIDER_EMAIL=fake
# Identidad verificada en SES (vacío = dirección de DEFAULT_FROM_EMAIL).
# El display name queda "<Negocio> vía <AWS_SES_FROM_NAME>".
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=MiRubro

# Habilitar/deshabilitar envío transaccional globalmente
# true = se envían emails | false = se crean EmailDelivery pero se marcan como failed
EMAIL_TRANSACTIONAL_ENABLED=true
# Emails de marketing (campañas, newsletters) — deshabilitado por defecto
EMAIL_MARKETING_ENABLED=false

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Seguridad / Admin ─────────────────────────────────────────────────────────
# Lista de CIDRs permitidos para /admin/ (opcional)
# Ejemplo: 192.168.1.0/24,10.0.0.1/32
ADMIN_IP_ALLOWLIST=
# Profundidad de proxies inversos: ALB=1, CloudFront+ALB=2
TRUSTED_PROXY_DEPTH=1

# ── Rollout flags ─────────────────────────────────────────────────────────────
ROLLOUT_NEW_ONBOARDING=false

# ── Misc ──────────────────────────────────────────────────────────────────────
# URL interna Docker del API (SSR/Celery → API sin pasar por el host)
API_URL_INTERNAL=http://api:8000
