# ── Django core ──────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=           # REQUIRED — generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_ALLOWED_HOSTS=api.mirubro.com,mirubro-api

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=mirubro
POSTGRES_USER=mirubro
POSTGRES_PASSWORD=           # REQUIRED
POSTGRES_HOST=postgres       # docker: postgres | prod: RDS endpoint
POSTGRES_PORT=5432

# ── Redis / Cache / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# ── CORS / Cookies ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://www.mirubro.com
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=.mirubro.com

# ── Public URLs ──────────────────────────────────────────────────────────────
BASE_PUBLIC_URL=https://api.mirubro.com
FRONTEND_URL=https://www.mirubro.com
PUBLIC_MENU_BASE_URL=https://www.mirubro.com

# ── MFA ──────────────────────────────────────────────────────────────────────
MFA_ENCRYPTION_KEY=          # REQUIRED — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_BOOTSTRAP_ENABLED=false

# ── MercadoPago ──────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=             # REQUIRED
MP_WEBHOOK_SECRET=           # REQUIRED

# ── Email (SendGrid) ────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=         # SendGrid API key
DEFAULT_FROM_EMAIL=Mirubro <no-reply@mirubro.com>

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ── Security ─────────────────────────────────────────────────────────────────
ADMIN_IP_ALLOWLIST=          # optional: comma-separated CIDR ranges
TRUSTED_PROXY_DEPTH=1        # ALB=1, CloudFront+ALB=2
