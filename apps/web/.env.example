# ── API URLs ─────────────────────────────────────────────────────────────────
# Client-side API URL (Browser access)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public base URL of this frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Server-side API URL (Docker: http://api:8000, Local: http://localhost:8000)
API_URL_INTERNAL=http://localhost:8000

# Production API hostname for next/image remote patterns (build-time only)
# API_HOSTNAME=api.mirubro.com

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Feature flag: when true, public auth shows Google as primary/only visible path.
NEXT_PUBLIC_AUTH_BETA_GOOGLE_ONLY=false

# Google Identity Services client ID for "Sign in with Google" on /entrar
# Get yours: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Embedded onboarding wizard for Gestión Comercial (MVP v1).
# Set to "true" to enable the /app/gestion/onboarding route and the resume banner.
NEXT_PUBLIC_NEW_ONBOARDING_ENABLED=false
