# =============================================================================
# apps/web/.env.example — MiRubro Frontend (Next.js)
# =============================================================================
# Copiar con: cp apps/web/.env.example apps/web/.env
# Este template tiene defaults para DESARROLLO LOCAL.
# Variables NEXT_PUBLIC_* se embeben en el bundle JS en build time.
# Cambiarlas después del build NO tiene efecto hasta hacer: docker compose build web
# NUNCA commites el archivo .env real.
# =============================================================================

# ── API URLs ──────────────────────────────────────────────────────────────────
# URL pública del API (acceso desde el browser del usuario)
# Local: http://localhost:8000 | Producción: https://www.mirubro.com (o subdominio API)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL pública de este frontend (usada para links, OG tags, redirects)
# Local: http://localhost:3000 | Producción: https://www.mirubro.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# URL interna del API para SSR (Docker: http://api:8000 — NUNCA localhost aquí en Docker)
# Docker: docker-compose.override.yml sobreescribe este valor con http://api:8000
# Local sin Docker: http://localhost:8000
API_URL_INTERNAL=http://localhost:8000
INTERNAL_API_URL=http://localhost:8000

# Hostname del API para next/image remote patterns (solo build time)
# Descomentar en producción: API_HOSTNAME=api.mirubro.com
# API_HOSTNAME=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Feature flag: cuando es true, /entrar muestra Google como única opción visible
NEXT_PUBLIC_AUTH_BETA_GOOGLE_ONLY=false

# Client ID de Google Identity Services para "Sign in with Google"
# Obtener en: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Wizard de onboarding para Gestión Comercial (MVP v1)
# "true" habilita la ruta /app/gestion/onboarding y el banner de resumen
NEXT_PUBLIC_NEW_ONBOARDING_ENABLED=false
